<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>AgenticAI</RootNamespace>
    <AssemblyName>AgenticAI</AssemblyName>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- DI container -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.14" />
    <!-- Optional: LLM-based planning (uncomment to enable) -->
    <!-- <PackageReference Include="Azure.AI.OpenAI" Version="2.0.0" /> -->
    <!-- <PackageReference Include="Anthropic.SDK" Version="1.0.0" /> -->
  </ItemGroup>

</Project>
